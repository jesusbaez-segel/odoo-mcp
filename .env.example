# Solo para desarrollo en este repositorio.
# El asistente de instalacion (instalar.bat) NO usa este archivo: guarda los
# datos en %APPDATA%\odoo-mcp\config.env, que es donde los lee el ejecutable.
#
# Copia este archivo como .env para trabajar con "uv run odoo-mcp".

# URL base de tu Odoo (sin barra final)
ODOO_URL=http://localhost:8069

# Nombre de la base de datos de Odoo
ODOO_DB=mi_base

# Tu usuario (email de inicio de sesion)
ODOO_USERNAME=admin@ejemplo.com

# API key (recomendado) o contrasena. La API key se genera en Odoo:
# Preferencias -> Seguridad de la cuenta -> Claves API -> Nueva clave
ODOO_API_KEY=
# ODOO_PASSWORD=
