# Copia este archivo como .env y rellena tus datos.

# URL base de tu Odoo. Si Odoo corre en esta misma máquina puedes dejar
# http://localhost:8069 : dentro del contenedor se reescribe automáticamente
# a host.docker.internal.
ODOO_URL=http://localhost:8069

# Nombre de la base de datos de Odoo
ODOO_DB=mi_base

# Tu usuario (email de inicio de sesión)
ODOO_USERNAME=admin@ejemplo.com

# API key (recomendado) o contraseña. La API key se genera en Odoo:
# Preferencias -> Seguridad de la cuenta -> Claves API -> Nueva clave
ODOO_API_KEY=
# ODOO_PASSWORD=
